# Copy this file to ".env" and paste the values from Firebase Console
# (Project settings > General > Your apps > SDK setup and configuration).
# These VITE_ values are bundled into the website. They are NOT secrets;
# your data is protected by Firestore Security Rules, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
